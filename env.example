# Puerto del servidor
PORT=3000

# Base de datos SQLite local (o cadena PostgreSQL si migras a nube)
DB_PATH=./data/muebles_artesanias.db

# API de Visión / OCR (ej. Gemini Vision o Google Cloud Vision)
VISION_API_KEY=TU_API_KEY_DE_VISION_AQUI

# Google Drive y Google Calendar (Cuenta de Servicio JSON en Base64 o ruta)
GOOGLE_DRIVE_FOLDER_MATRIZ=ID_CARPETA_DRIVE_MATRIZ
GOOGLE_DRIVE_FOLDER_SUCURSAL=ID_CARPETA_DRIVE_SUCURSAL
GOOGLE_CALENDAR_ID_MATRIZ=ID_CALENDARIO_MATRIZ
GOOGLE_CALENDAR_ID_SUCURSAL=ID_CALENDARIO_SUCURSAL

# Correo SMTP para envío automático de formato firmado de entregas
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=entregas@tudominio.com
SMTP_PASS=TU_CONTRASEÑA_DE_APLICACION

# Webhook externo opcional (Zapier / Make / n8n)
EXTERNAL_WEBHOOK_URL=

# Credencial Chofer Logística
DRIVER_PIN=1111
